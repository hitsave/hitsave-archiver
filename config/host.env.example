# Source before docker compose from hitsave-archiver (copy into your private config dir or repo root).
export HITSAVE_PRIVATE_CONFIG=/path/to/hitsave-archiver-config
export HOST_PRESS_MATERIAL=/path/to/press-material
export HOST_SUBMISSIONS=/path/to/hitsave-archiver/submissions
export HOST_OUTPUT=/path/to/hitsave-archiver/output
# Ledger Postgres data dir (must exist, owned by uid 70, mode 700) and pg_dump target.
export HOST_LEDGER_DATA=/path/to/hitsave-archiver/ledger/pgdata
export HOST_LEDGER_BACKUPS=/path/to/hitsave-archiver/ledger/dumps
export HOST_INTAKE=/path/to/hitsave-archiver/intake
# Planned analog on-site / handoff tree (Phase 2 — see docs/remote-intake-lanes.md):
# export HOST_ANALOG=/path/to/hitsave-archiver/analog
