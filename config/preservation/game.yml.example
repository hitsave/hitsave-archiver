# Copy to game.yml (gitignored). Paths and limits come from config/preservation/ingest.yaml
# via resolve_game_config (see docs/config-contract.md).
#
# Run: docker compose run --rm ingest-worker /config/preservation/game.yml
#
# Ledger game_key (package_id) is assigned at ingest — do not set game_key here.

ingest_kind: press_material
source_subpath: Example/Publisher/GameFolder
omeka_item_title: "Example Game — press material"

# Optional overrides (container paths; defaults from resolve_game_config):
# bagit_bag_dir: /output/bag/example-game
# staging_dir: /output/.staging/example-game
# aip_bag_dir: /output/bag/example-game
# max_files: 5000
# max_total_bytes: 5368709120
