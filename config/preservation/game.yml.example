# Copy to game.yml (gitignored) for a single press-material folder ingest.
# Run: docker compose run --rm ingest-worker /config/preservation/game.yml
#
# Paths below are inside the ingest-worker container.

source_game_folder: /data/press-material/Example/Publisher/GameFolder
output_tar: /output/dip/example-game.tar
staging_dir: /output/.staging/example-game
aip_bag_dir: /output/aip/example-game
game_key: example-game
omeka_item_title: "Example Game — press material"
max_files: 5000
max_total_bytes: 5368709120

preservation:
  repository_code: hitsave
  agent_name: HitSave archive ingest
  agent_version: build-dip-e-ark.py
