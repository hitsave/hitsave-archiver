# Copy to batch-<slug>.yml (gitignored). batch_key is derived from the file name
# (e.g. batch-repcopies-f-5.yml → repcopies-f-5).
#
# Expand: ./scripts/batch-expand-preservation.sh config/preservation/batch-my-run.yml
# Run:    bash scripts/run-batch-preservation-omeka.sh config/preservation/batch-my-run.yml

ingest_kind: press_material
source_subpath: Representation_Copies/T

select:
  min_bytes: 1048576
  max_bytes: 524288000
  limit: 25
  sort_by: size # size | name

# Optional: override default batch output dirs (otherwise derived from ingest.yaml paths.*)
# output:
#   dip_dir: /output/dip/batch/my-batch-key
#   aip_dir: /output/aip/batch/my-batch-key
#   staging_dir: /output/.staging/batch/my-batch-key

omeka_item_title_suffix: ""
