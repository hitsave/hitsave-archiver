# Pin CLI version; bump intentionally when upgrading Windmill server.
FROM node:22-bookworm-slim

ARG WINDMILL_CLI_VERSION=1.849.0
RUN npm install -g "windmill-cli@${WINDMILL_CLI_VERSION}" \
  && wmill --version

COPY wmill-cli-entrypoint.sh /usr/local/bin/wmill-cli-entrypoint.sh
RUN chmod +x /usr/local/bin/wmill-cli-entrypoint.sh

WORKDIR /workspace
ENTRYPOINT ["/usr/local/bin/wmill-cli-entrypoint.sh"]
