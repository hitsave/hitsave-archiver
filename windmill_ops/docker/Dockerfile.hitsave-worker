# Windmill worker with Docker CLI for bash scripts that call `docker compose` on the archiver stack.
FROM ghcr.io/windmill-labs/windmill:main

USER root
RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    docker.io ca-certificates curl python3-pip \
  && rm -rf /var/lib/apt/lists/*
# Compose pinned to the version on the host (Docker's docker-compose-plugin). Compose versions
# compute different config hashes for the same service, and a mismatch made the worker and the
# host recreate clamav for each other (see scripts/compose_shared.sh). When the host's
# docker-compose-plugin is upgraded, update these two values and rebuild the worker.
ARG COMPOSE_VERSION=5.5.1
ARG COMPOSE_SHA256=db1889184726840f75c4f9c001048430d4f25b3be3cb084d3ddd762bc0aed576
RUN mkdir -p /usr/libexec/docker/cli-plugins \
  && curl -fsSL -o /usr/libexec/docker/cli-plugins/docker-compose \
    "https://github.com/docker/compose/releases/download/v${COMPOSE_VERSION}/docker-compose-linux-x86_64" \
  && echo "${COMPOSE_SHA256}  /usr/libexec/docker/cli-plugins/docker-compose" | sha256sum -c - \
  && chmod 755 /usr/libexec/docker/cli-plugins/docker-compose \
  && docker compose version
# Bash ops scripts use system python3; Windmill-isolated Python uses global-site-packages.
RUN python3 -m pip install --no-cache-dir --break-system-packages 'psycopg[binary]' pyyaml \
  && mkdir -p /tmp/windmill/cache/python_3_13/global-site-packages \
  && uv pip install --system 'psycopg[binary]' pyyaml \
    --target /tmp/windmill/cache/python_3_13/global-site-packages
