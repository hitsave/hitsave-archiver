# Copy to .env next to docker-compose.yml and adjust.
WM_IMAGE=ghcr.io/windmill-labs/windmill:main
DATABASE_URL=postgres://postgres:windmill-spike-change-me@windmill_db:5432/windmill
POSTGRES_PASSWORD=windmill-spike-change-me
# Host path to hitsave-archiver checkout (this worktree or dev clone)
ARCHIVER_HOST_PATH=/home/jonas/hitsave-e2e/hitsave-archiver
HITSAVE_PRIVATE_CONFIG_HOST=/home/jonas/hitsave-e2e/hitsave-archiver-config
# gdrive-intake checkout (API poll config + secrets; not a Drive filesystem mount)
HITSAVE_GDRIVE_INTAKE_HOST=/home/jonas/hitsave-e2e/hitsave-gdrive-intake

# Windmill CLI (create token in UI: Settings → Account → Tokens)
WMILL_TOKEN=
# Used when registering workspace from the CLI container (Docker network)
WINDMILL_CLI_BASE_URL=http://windmill_server:8000
